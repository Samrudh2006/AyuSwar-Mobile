<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Device-reported: Android nav buttons render white-on-pale (invisible) over the
             app backdrop. Ask the system for dark nav-bar icons. API 27+; ignored below.
             NOT device-verified yet. -->
        <item name="android:windowLightNavigationBar">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Android 11 and earlier: windowBackground bitmap from drawable-port-*/splash.png.
             The compat splash lib is dormant here (installSplashScreen is never called),
             so it does not shadow windowBackground on pre-31. Expected standard
             windowBackground behavior, but NOT runtime-verified on hardware yet. -->
        <item name="android:background">@drawable/splash</item>
        <!-- Android 12+ system splash: color background + emblem as the centered icon.
             (developer.android.com: image windowBackground is ignored on API 31+;
             only windowSplashScreenBackground color + windowSplashScreenAnimatedIcon apply.) -->
        <item name="windowSplashScreenBackground">#FAF5EA</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">#FAF5EA</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>