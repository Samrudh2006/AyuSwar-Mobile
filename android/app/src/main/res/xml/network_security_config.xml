<?xml version="1.0" encoding="utf-8"?>
<!--
  AyuSwar network security config (rural-PHC brief: certificate pinning).

  - Cleartext HTTP is disabled app-wide.
  - The API backend host is pinned to the public keys observed on its live
    certificate chain on 2026-11-20:
      pin 1: GTS Root R1 (root CA of the served chain)
      pin 2: WR1 (Google Trust Services intermediate that issued the leaf)
      pin 3: ISRG Root X1 (BACKUP, independent hierarchy). Vercel's docs
        state certificates are issued by Let's Encrypt while the chain
        actually served on 2026-11-20 was Google Trust Services, so the
        issuer CAN switch. Without a pin from a second hierarchy such a
        switch would hard-fail the app. Pin computed from the official
        root certificate fetched from letsencrypt.org on 2026-11-20
        (self-signed, valid 2015-06-04 to 2035-06-04).
    The leaf certificate itself is NOT pinned - Vercel rotates it often.
  - MAINTENANCE: if the backend moves hosts or Vercel changes issuing CA
    (e.g. fully to Let's Encrypt), the ISRG backup keeps connectivity,
    but the GTS pins should then be refreshed. As a safety valve the
    pin-set expires 2027-05-20; after that Android falls back to normal
    system trust instead of hard-failing. Re-verify the served chain and
    refresh pins before that date (rotation review).
    Trust scope: Android accepts the connection when ANY pin matches
    anywhere in the chain, so this pins trust to the named root/intermediate
    CAs as a whole, not to one specific server certificate.
  - Scope note: Android WebView enforcement of pins for in-page fetch/XHR
    varies by WebView version; this config is enforced for app-level
    connections and is not a substitute for server-side caller auth.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config>
        <domain includeSubdomains="true">ayuswar-ai.vercel.app</domain>
        <pin-set expiration="2027-05-20">
            <pin digest="SHA-256">hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</pin>
            <pin digest="SHA-256">yDu9og255NN5GEf+Bwa9rTrqFQ0EydZ0r1FCh9TdAW4=</pin>
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
        </pin-set>
        <certificates src="system" />
    </domain-config>
</network-security-config>
